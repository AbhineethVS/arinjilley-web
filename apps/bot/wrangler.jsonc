{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arinjilley-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Not secrets.
    "OWNER_TELEGRAM_ID": "7204471811",
    // gpt-5-mini was clearly more accurate than gpt-5-nano on real posts (dates, free/paid, titles) at
    // about half a US cent per listing. Change here if OpenAI's lineup changes.
    "OPENAI_MODEL": "gpt-5-mini",
    "OPENAI_REASONING": "minimal",
    // AI rate limits (protect the OpenAI credit). The OpenAI dashboard budget is the final safety net.
    "AI_LIMIT_PER_ADMIN_PER_HOUR": "15",
    "AI_LIMIT_PER_DAY": "60",
    "AI_MAX_INPUT_CHARS": "6000",
    // gpt-5-mini list prices (USD per million tokens, checked 17 Oct 2026), only used for /usage estimates.
    "AI_PRICE_INPUT_PER_M": "0.25",
    "AI_PRICE_OUTPUT_PER_M": "2.00",
    // Public website and the club's WhatsApp group, both used in the WhatsApp text.
    "SITE_URL": "https://arinjilley.pages.dev",
    "GROUP_URL": "https://chat.whatsapp.com/HRgBh8m962qGtkhIbVu9WH"
  },
  // The bot calls itself to run slow steps as separate jobs (see src/jobs.ts).
  "services": [{ "binding": "SELF", "service": "arinjilley-bot" }],
  // Every minute: retry anything that was missed (stuck batches, posters waiting for a free browser).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arinjilley",
      "database_id": "81ff0986-2c48-4660-a128-c1dfd0cbca88",
      "migrations_dir": "../../migrations"
    }
  ],
  // Cloudflare Browser Rendering (free: 10 browser-minutes/day), used to screenshot posters.
  "browser": { "binding": "BROWSER" }
}
