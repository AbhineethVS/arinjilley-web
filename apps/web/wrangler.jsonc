{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The public website, on Cloudflare Pages: https://arinjilley.pages.dev
  // Build with `npm run build` (writes dist/), deploy with `npm run deploy`.
  "name": "arinjilley",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_URL": "https://arinjilley.pages.dev",
    "GROUP_URL": "https://chat.whatsapp.com/HRgBh8m962qGtkhIbVu9WH"
  },
  // Same database as the bot (the site only reads live listings).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arinjilley",
      "database_id": "81ff0986-2c48-4660-a128-c1dfd0cbca88"
    }
  ]
}
